<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system's splash shows no icon, so the app's own launch screen writes out the whole name. -->
    <style name="Theme.HomeoRemedica" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
